<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    android:visibility="invisible">

    <!-- Background ring animation -->
    <View
        android:id="@+id/ringAnimation"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_call_ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Avatar / VibeMate icon -->
    <ImageView
        android:id="@+id/vibeMateAvatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_phone"
        android:tint="@android:color/white"
        android:background="@drawable/bg_call_avatar"
        android:scaleType="centerInside"
        android:padding="26dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Person being called name -->
    <TextView
        android:id="@+id/callPartnerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VibeMate"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/vibeMateAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call status (ringing/connected) -->
    <TextView
        android:id="@+id/callStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calling..."
        android:textSize="16sp"
        android:textColor="#A0A0A0"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/callPartnerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call duration timer -->
    <TextView
        android:id="@+id/callDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/callStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Live transcript: what the AI HEARD (🎤) and what it SAID (🔊).
         LiveCallEngine feeds these, so the user can see the voice loop working
         even with the speaker on hiss / the volume low. -->
    <TextView
        android:id="@+id/callTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:maxLines="5"
        android:gravity="center"
        android:text="Mic ready — go ahead, I'm listening…"
        android:textColor="#C8C8C8"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/callDuration"
        app:layout_constraintBottom_toTopOf="@id/endCallButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0" />

    <!-- Mute / unmute the microphone during the call (stops the AI from hearing
         its own speaker output on a loudspeaker, or the room around you). -->
    <ImageButton
        android:id="@+id/callMuteButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_audio"
        android:background="@drawable/bg_call_button"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:alpha="0.45"
        android:onClick="onMuteCallClicked"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toTopOf="@id/endCallButton"
        app:layout_constraintBottom_toBottomOf="@id/endCallButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- End call button (big red button) -->
    <ImageButton
        android:id="@+id/endCallButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_phone_end"
        android:background="@drawable/bg_end_call_button"
        android:scaleType="centerInside"
        android:onClick="onEndCallClicked"
        android:padding="12dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Close button (top right) -->
    <ImageButton
        android:id="@+id/closeCallButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        android:onClick="onCloseCallClicked"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>