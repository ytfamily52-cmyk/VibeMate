# ============================================================================
#  VibeMate — template for the PRIVATE secrets file.
# ============================================================================
#  1. Copy this file to `secrets.properties` (same folder).
#  2. Fill in your real keys.
#  3. `secrets.properties` is git-ignored — it will NEVER be committed.
#
#  app/build.gradle.kts reads it and injects the values into BuildConfig,
#  which AppConfig.kt then reads. No key is ever hardcoded in the source.
# ============================================================================

# The 18+ Private room's OpenAI-compatible provider.
# Default = OpenRouter — https://openrouter.ai/keys
#   Set a monthly spend LIMIT on the key in the OpenRouter dashboard.
# ANY OpenAI-compatible provider also works: change OPENROUTER_BASE_URL and the
# model ids in AppConfig.kt, and paste that provider's key here instead.
#   e.g. Venice AI (uncensored, zero-retention, 500 free credits, no card):
#        OPENROUTER_BASE_URL = https://api.venice.ai/api/v1
#        chat model          = venice-uncensored-1-2   ($0.20/$0.90 per 1M)
#        fallback models     = venice-uncensored-role-play,qwen-3-6-plus
#        key from https://venice.ai/settings/api
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_OPENROUTER_KEY_HERE

# Google Gemini (normal chats) — https://aistudio.google.com/app/apikey
# Restrict the key to the Android app (package + SHA-1) in Google Cloud Console.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_API_KEY_2=
