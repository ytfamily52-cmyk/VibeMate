<?xml version="1.0" encoding="utf-8"?>
<!-- One message row: role + time header, caption, inline photo, file label. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bubble_admin_mate"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/adminMsgHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#667781"
        android:textSize="11sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/adminMsgImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:contentDescription="Shared photo"
        android:maxWidth="240dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/adminMsgBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/admin_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/adminMsgFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#0277BD"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>