<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase Auth + Firestore (both HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_admin_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_admin_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VibeMate.Admin">

        <!-- Sign-in (admin account only) — the launcher screen. -->
        <activity
            android:name=".AdminLoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Every user of the app. -->
        <activity
            android:name=".AdminUsersActivity"
            android:exported="false" />

        <!-- One user's chats. -->
        <activity
            android:name=".AdminChatsActivity"
            android:exported="false" />

        <!-- One chat's messages. -->
        <activity
            android:name=".AdminMessagesActivity"
            android:exported="false" />
    </application>

</manifest>
